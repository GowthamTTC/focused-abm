# ── Database (Railway Postgres or local) ──────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/focused_abm

# ── Auth ──────────────────────────────────────────────────────────────
SESSION_SECRET=change-me-32-chars-minimum-random
ADMIN_EMAIL=you@company.com
ADMIN_PASSWORD=set-on-first-seed

# ── LLM via OpenRouter (routes to Claude) ────────────────────────────
OPENROUTER_API_KEY=sk-or-...
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_CLASSIFY=anthropic/claude-haiku-4.5
LLM_MODEL_DEEPDIVE=anthropic/claude-sonnet-4.6

# ── Unipile (leave empty until Day 4 — mock provider runs without it) ─
UNIPILE_API_KEY=
UNIPILE_DSN=            # e.g. api123.unipile.com:14567 (no protocol)

# ── App ───────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000
DEEP_ENRICH_DAILY_CAP=80
DEEP_ENRICH_MIN_GAP_SECONDS=25
